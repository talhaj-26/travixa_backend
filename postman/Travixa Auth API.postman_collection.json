    {
      "name": "10 - Anonymous admin access returns 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Anonymous request is unauthorized', () => pm.response.to.have.status(401));"
            ]
